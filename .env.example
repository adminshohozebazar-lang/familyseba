# PostgreSQL connection string used by Prisma (Neon).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth
# NEXTAUTH_URL should match the URL the app is served from (no trailing slash).
# NEXTAUTH_SECRET: generate one with `openssl rand -base64 32`.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-base64-string"

# Single-admin login (no User table — see prisma/schema.prisma). Generate
# ADMIN_PASSWORD_HASH with: npx tsx scripts/hash-password.ts <your-password>
# IMPORTANT: escape every literal $ in the hash as \$ — Next.js expands
# unescaped $NAME patterns in .env values, which silently corrupts bcrypt
# hashes (they start with $2a$10$...) and makes login fail with no error.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH="\$2a\$10\$replace.with.the.escaped.output.of.the.hash-password.script"

# Cloudinary (signed uploads only — no unsigned upload preset)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
